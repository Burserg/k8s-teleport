#!/usr/bin/env bash
set -euo pipefail

ci_user='${ci_user}'

if ! id -u "$ci_user" >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash --groups sudo "$ci_user"
fi

install -d -m 0700 -o "$ci_user" -g "$ci_user" "/home/$ci_user/.ssh"
cat > "/home/$ci_user/.ssh/authorized_keys" <<'AUTHORIZED_KEYS'
${ssh_authorized_keys}
AUTHORIZED_KEYS
chown "$ci_user:$ci_user" "/home/$ci_user/.ssh/authorized_keys"
chmod 0600 "/home/$ci_user/.ssh/authorized_keys"

cat > "/etc/sudoers.d/$ci_user" <<EOF
$ci_user ALL=(ALL) NOPASSWD:ALL
EOF
chmod 0440 "/etc/sudoers.d/$ci_user"
