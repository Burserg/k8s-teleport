#cloud-config
hostname: ${hostname}
fqdn: ${hostname}.${searchdomain}
preserve_hostname: false

users:
  - name: ${ci_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{ for key in ssh_keys ~}
      - ${key}
%{ endfor ~}

ssh_pwauth: false
package_update: false
package_upgrade: false

growpart:
  mode: auto
  devices: ["/"]
