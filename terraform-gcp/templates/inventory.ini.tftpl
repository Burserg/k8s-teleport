# Generated by OpenTofu - do not edit by hand.
# All Kubernetes nodes are private. Ansible reaches them through the public
# bastion; Kubernetes binds to each node's private address.

[jump]
${jump_name} ansible_host=${jump_reach} cluster_ip=${jump_cluster}

[control]
%{ for name, node in controls ~}
${name} ansible_host=${node.cluster} cluster_ip=${node.cluster}
%{ endfor ~}

[workers]
%{ for name, node in workers ~}
${name} ansible_host=${node.cluster} cluster_ip=${node.cluster}
%{ endfor ~}

[lab:children]
control
workers

# Selecting this group enables Cilium's cloud/host-network configuration.
[gcp:children]
lab

[managed:children]
lab
jump

[all:vars]
ansible_user=${ci_user}

[lab:vars]
ansible_ssh_common_args='-o ProxyJump=${ci_user}@${jump_reach} -o StrictHostKeyChecking=accept-new'
