# Generated by Terraform - do not edit by hand.
#
# Kubernetes nodes are single-homed on the cluster VLAN. If a jump host is
# defined AND dual-homed, cluster nodes are reached through it; if the VLAN
# is directly routable, they are reached directly and the bastion exists for
# human access rather than as a mandatory hop.
#
# ansible_host is how the CONTROL MACHINE reaches the node.
# cluster_ip is the address Kubernetes binds to.

%{ if jump_name != "" ~}
[jump]
${jump_name} ansible_host=${jump_reach} cluster_ip=${jump_cluster}

%{ endif ~}
[control]
%{ for name, n in controls ~}
${name} ansible_host=${n.cluster} cluster_ip=${n.cluster}
%{ endfor ~}

[workers]
%{ for name, n in workers ~}
${name} ansible_host=${n.cluster} cluster_ip=${n.cluster}
%{ endfor ~}

[lab:children]
control
workers

# Select libvirt-specific Ansible values without affecting the Proxmox or GCP
# inventories.
[libvirt:children]
lab

# Everything Ansible manages, including the bastion. Base hardening applies
# here; Kubernetes roles apply only to [lab].
[managed:children]
lab
%{ if jump_name != "" ~}
jump
%{ endif ~}

[all:vars]
ansible_user=${ci_user}
%{ if proxy_jump ~}

# The cluster VLAN is not routable from the control machine, so Kubernetes
# nodes are reached through the bastion. Remove the bastion's mgmt_ip once
# the VLAN is directly routable and this block disappears.
[lab:vars]
ansible_ssh_common_args='-o ProxyJump=${ci_user}@${jump_reach} -o StrictHostKeyChecking=accept-new'
%{ endif ~}
