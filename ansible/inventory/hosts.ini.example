# Hand-write this file, or let terraform/ generate it.
#
# Any Linux hosts work
#   ansible_host  how THIS machine reaches the node
#   cluster_ip    the address Kubernetes binds to

# Optional. Hosts Ansible. Delete this group fi managing locally
# falls back to running the controller role on ctrl-01.
[jump]
jump-01 ansible_host=192.168.2.10 cluster_ip=192.168.2.10

[control]
ctrl-01 ansible_host=192.168.2.11 cluster_ip=192.168.2.11

[workers]
wrkr-01 ansible_host=192.168.2.21 cluster_ip=192.168.2.21
wrkr-02 ansible_host=192.168.2.22 cluster_ip=192.168.2.22

# Kubernetes nodes.
[lab:children]
control
workers

# Everything Ansible manages. Base hardening applies here.
# Kubernetes roles apply only to [lab].
[managed:children]
lab
jump

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519

# If the cluster VLAN is not routable from this machine
# uncomment to proxy through the specified host.
# [lab:vars]
# ansible_ssh_common_args='-o ProxyJump=ubuntu@192.168.2.10 -o StrictHostKeyChecking=accept-new'
