# ============================================================
# The only Terraform file you should need to edit.
# Run `qm config <your-template-vmid>` first and match the template block.
# ============================================================

proxmox_endpoint   = "https://pve.example.lan:8006/api2/json"
proxmox_api_token  = "terraform@pve!terraform"
proxmox_api_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
target_node        = "pve"

# --- template: verify every line against `qm config` ---
template_name         = "ubuntu-2604-cloudinit"
storage               = "local-lvm"
bios                  = "seabios"   # "ovmf" if your template is UEFI
efi_pre_enrolled_keys = false       # only read when bios = "ovmf"
scsihw                = "virtio-scsi-single"
cloudinit_slot        = "ide2"      # the slot with media=cdrom,*-cloudinit
os_disk_slot          = "scsi0"     # the slot with the real disk
disk_size             = "32G"
qemu_agent            = 0

# --- network ---
network_bridge = "vmbr0"
vlan_tag       = 0            # 0 = untagged
subnet_prefix  = 24
gateway        = "192.168.1.1"
nameserver     = "192.168.1.1"
searchdomain   = "lab.local"

# --- identity ---
ci_user = "ubuntu"
admin_ssh_public_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@workstation",
]

# --- nodes: set ip = null for DHCP (needs qemu_agent = 1) ---
nodes = {
  "ctrl-01" = { vmid = 3001, ip = "192.168.1.11", cores = 2, memory = 4096, role = "control" }
  "wrkr-01" = { vmid = 3002, ip = "192.168.1.21", cores = 4, memory = 8192, role = "worker" }
  "wrkr-02" = { vmid = 3003, ip = "192.168.1.22", cores = 4, memory = 8192, role = "worker" }
}
